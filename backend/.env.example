# Copy to `.env` and fill in keys. Never commit `.env`.
# Meta Model API (OpenAI-compatible) — voice, SAM, wonder/spark.
META_API_KEY=
META_API_BASE_URL=https://api.meta-model.example/v1
# Baseten (OpenAI-compatible) — open-weight chart generator.
BASETEN_API_KEY=
BASETEN_API_BASE_URL=https://api.baseten.example/v1
# dev → critic uses muse-spark-1.3-contributor (cost control).
# prod/demo → critic uses muse-wonder-1.0.
ENV=dev
